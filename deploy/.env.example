# cockpit 全栈 compose · env 事实源（占位值，可入仓）
#
# 用法：cp deploy/.env.example deploy/.env 然后填真值。
# deploy/.env 被 .gitignore 的 **/.env 规则忽略，**不进仓**（铁律 2：密钥永不进 Git）。
#
# compose 会自动加载同目录 deploy/.env 做 ${...} 插值，auth 服务还会 env_file 读它拿密钥。

# ── mongo 数据卷 ───────────────────────────────────────────────
# 复用同一个 named volume。生产＝cockpit-mongo-data（现手动栈的 mongo 卷）。
# 验证时改指独立测试卷（如 cockpit-validate-mongo-data），别碰生产数据。
# 注意：卷是 external，需先 `docker volume create <名字>` 才能起（生产卷已存在）。
MONGO_VOLUME_NAME=cockpit-mongo-data

# ── nexus-core ─────────────────────────────────────────────────
# 生产库名＝nexus_core（现手动栈用的库）。验证时用带 _test 的独立库，别写生产库。
NEXUS_DB_NAME=nexus_core
# 日界与「今天」的 IANA 时区名。缺失/猜错会把工作静默记到错误的日子（无默认值语义）。
NEXUS_TZ=Asia/Shanghai

# ── auth 密钥（真值只进 deploy/.env，不进仓）────────────────────
# 与现手动栈 code/auth/code/backend/.env 里的一致，切换时用户体验才连续（会话/口令不变）。
AUTH_PASSWORD=change-me-login-password
AUTH_SECRET=change-me-cookie-signing-secret-must-differ-from-password

# ── nginx 对外入口 ─────────────────────────────────────────────
# 宿主监听「IP:端口」，映射到 nginx 容器的 80。IP 由路由器固定为 192.168.31.181。
NGINX_HOST_BIND=192.168.31.181:10000

# HoneyComb 网关 · 唯一入口（手写的默认组装：nexus-core + hive + ring + 登录门占位件）
#
# 这是 envsubst 模板：nginx 官方镜像启动时把它渲染成 /etc/nginx/conf.d/default.conf。
# 只替换 NGINX_ENVSUBST_FILTER 放行的变量（AUTH_UPSTREAM、HONEYCOMB_*），
# 其余 `$host` 之类照样是 nginx 自己的变量。
#
# 对外冻结的接口（部署方靠这些接自己的东西，不改、不复制本仓文件）见
# contracts/gateway.v1/contract.md。`./install.sh add hive ring` 生成行为相同的一份
# （deploy/generated/），CI 两份都起一遍核对。
server {
    listen 80;
    server_name _;
    charset utf-8;

    # 跳转一律用相对 Location（2026-09-14 真机 bug）：
    # 默认 absolute_redirect on 时 nginx 会拿 $host 拼绝对 URL，而 $host **不带端口**，
    # 于是 http://IP:8800/ 的 302 跳到了 http://IP/hive/ —— 打到 80 端口上，
    # 那里通常是别的服务，浏览器看到的就是「自动转 /hive/ 然后 502」。
    absolute_redirect off;

    # 站点前缀（gateway.v1）：缺省 `/`；整站挂子路径时如 `/Cockpit/`（以 / 开头和结尾）。
    # 下面每个对外 location 都写成 ${HONEYCOMB_BASE_PATH}xxx（nginx 的 location 路径
    # 不接受变量，只能渲染时写成字面量）；取值处用 $honeycomb_base。转给后端与认证服务
    # 时去掉前缀（proxy_pass 带 URI），它们永远看到 /api/...。
    # /healthz 与 /__auth_verify 不加前缀：前者只给容器健康检查，后者是内部子请求。
    set $honeycomb_base "${HONEYCOMB_BASE_PATH}";

    # 顶栏页签：装了哪些前端就有哪些页签（inject.inc 把它注入页面）。
    set $honeycomb_nav '{"home":"${HONEYCOMB_BASE_PATH}hive/","timer":"${HONEYCOMB_BASE_PATH}ring/","tabs":[{"href":"${HONEYCOMB_BASE_PATH}hive/","label":"任务"},{"href":"${HONEYCOMB_BASE_PATH}ring/","label":"计时"}]}';

    location = /healthz { return 200 "ok\n"; add_header Content-Type text/plain; }

    # 根路径跳主界面（任务蜂巢）。未登录的话 /hive/ 自己会再跳 /login/，
    # 登录页登录成功后默认回 /，于是又落到这里 —— 一圈下来正好进蜂巢。
    location = ${HONEYCOMB_BASE_PATH} { return 302 ${HONEYCOMB_BASE_PATH}hive/; }

    # ── 登录门（gateway.v1 冻结：/__auth_verify 与 @to_login 这两个名字）──
    #
    # /__auth_verify 是内部子请求专用：auth_request 在放行每个受保护请求之前
    # 先内部调它一次，2xx＝放行、401＝拒绝。internal：外部直接访问 404。
    # 客户端自带的 X-Nexus-Tenant 不转给认证服务——租户只能由认证服务说了算。
    location = /__auth_verify {
        internal;
        proxy_pass http://${AUTH_UPSTREAM}/api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Nexus-Tenant "";
        proxy_set_header X-Original-URI $request_uri;
    }
    location @to_login {
        return 302 ${HONEYCOMB_BASE_PATH}login/;
    }

    # 认证服务的**整个** /api/auth/ 前缀都转过去（gateway.v1）。
    # **这一段不设门**：登录接口必须未登录可达。所以替换进来的认证服务，
    # 它在这个前缀下的每个非登录端点都得**自己**鉴权——网关不替它挡。
    location ${HONEYCOMB_BASE_PATH}api/auth/ {
        proxy_pass http://${AUTH_UPSTREAM}/api/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Nexus-Tenant "";
    }

    # 登录页。目录由 HONEYCOMB_LOGIN_DIR 挂进来（缺省是登录门占位件自带的页面）。
    # 不设门、不注入顶栏：还没进门就给导航是错的。
    location ${HONEYCOMB_BASE_PATH}login/ {
        alias /usr/share/nginx/html/login/;
        index index.html;
        try_files $uri $uri/ =404;
    }

    # 顶栏、设计 tokens、站点图标（modules/nginx-docker/static）。不含用户数据，不设门。
    location ${HONEYCOMB_BASE_PATH}__cockpit/ {
        alias /usr/share/nginx/html/__cockpit/;
        add_header Cache-Control "no-cache";
    }
    location = ${HONEYCOMB_BASE_PATH}favicon.ico { alias /usr/share/nginx/html/__cockpit/favicon.ico; }
    location = ${HONEYCOMB_BASE_PATH}favicon.svg { alias /usr/share/nginx/html/__cockpit/favicon.svg; }

    # 顶栏的计时芯片只打这一个端点（约 10s 一次），固定映射到 views/current。
    #
    # **必须设门**：它回的是"你此刻在做什么"，是用户数据。
    # 但 401 不能跳登录页——每 10s 一次的 XHR 拿到 302 毫无意义——所以未登录、
    # 后端挂了都回同一份降级 JSON，顶栏渲染成"状态未知"，既不泄露也不刷 console。
    location = ${HONEYCOMB_BASE_PATH}__cockpit/current {
        auth_request /__auth_verify;
        auth_request_set $honeycomb_tenant $upstream_http_x_nexus_tenant;
        error_page 401 = @cockpit_degraded;
        proxy_pass http://nexus-core:8000/api/core/views/current;
        proxy_set_header Host $host;
        proxy_set_header X-Nexus-Tenant $honeycomb_tenant;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @cockpit_degraded;
    }
    location @cockpit_degraded {
        default_type application/json;
        return 200 '{"degraded":true,"running":false}';
    }

    # 后端。每个请求先过门；租户由网关覆盖（gate.inc）。
    location ${HONEYCOMB_BASE_PATH}api/core/ {
        include /etc/nginx/honeycomb/gate.inc;
        proxy_pass http://nexus-core:8000/api/core/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # 前端页面本身也设门：未登录直接去登录页，而不是先渲染一个空壳、
    # 再让里面每个 /api/ 请求挨个 401。顶栏由网关注入（inject.inc）。
    location ${HONEYCOMB_BASE_PATH}hive/ {
        include /etc/nginx/honeycomb/gate.inc;
        include /etc/nginx/honeycomb/inject.inc;
        alias /usr/share/nginx/html/hive/;
        index index.html;
        try_files $uri $uri/ ${HONEYCOMB_BASE_PATH}hive/index.html;
    }
    location ${HONEYCOMB_BASE_PATH}ring/ {
        include /etc/nginx/honeycomb/gate.inc;
        include /etc/nginx/honeycomb/inject.inc;
        alias /usr/share/nginx/html/ring/;
        index project-task-contribution-ring.html;
        try_files $uri $uri/ ${HONEYCOMB_BASE_PATH}ring/project-task-contribution-ring.html;
    }

    # 部署方的额外路由（HONEYCOMB_EXTRA_ROUTES_DIR 里的 *.conf.template，渲染后落在这里）。
    # 缺省是空目录。写法见 contracts/gateway.v1/contract.md。
    include /etc/nginx/conf.d/extra/*.conf;
}

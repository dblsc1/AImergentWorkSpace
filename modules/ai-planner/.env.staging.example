# 只提交变量名与无敏占位值；禁止在本文件填入真实密钥。
# 详见 module_docs/contract.md「配置与密钥」。

# nexus 基址（必填，缺失即 die）
AI_PLANNER_NEXUS_BASE=http://127.0.0.1:8000
# nexus 登录凭据（口令或预置 cookie 二选一，运行时从 env 注入，绝不填真值）
AI_PLANNER_NEXUS_PASSWORD=inject-at-runtime
# AI_PLANNER_NEXUS_COOKIE=inject-at-runtime
# 监听地址（默认 127.0.0.1:8700，不得为 0.0.0.0）
AI_PLANNER_BIND=127.0.0.1:8700
# 驱动可插拔：codex|deepseek，默认 deepseek（codex 登录态被吊销时的默认理由见 contract.md）
# AI_PLANNER_DRIVER=deepseek
# codex 驱动（默认可留空；AI_PLANNER_DRIVER=codex 时才生效）
# AI_PLANNER_CODEX_BIN=codex
# AI_PLANNER_CODEX_MODEL=
# AI_PLANNER_CODEX_TIMEOUT_S=120
# deepseek 驱动（AI_PLANNER_DRIVER=deepseek 时 API_KEY 必填，运行时从 env 注入，绝不填真值）
# AI_PLANNER_DEEPSEEK_API_KEY=inject-at-runtime
# AI_PLANNER_DEEPSEEK_BASE=https://api.deepseek.com
# AI_PLANNER_DEEPSEEK_MODEL=deepseek-v4-flash
# AI_PLANNER_DEEPSEEK_TIMEOUT_S=120
# AI_PLANNER_DEEPSEEK_MAX_TOKENS 默认 2000（推理模型合计预算，下限 200，见 config.py）
# F-GUIDE 说明书路径（默认 contracts/ai-planner-guide-v1.md）
# AI_PLANNER_GUIDE_PATH=contracts/ai-planner-guide-v1.md

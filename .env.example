# 框架用到的全部环境变量（18 个）。复制为 .env 按需覆盖；不填就用默认值。
# 这里是唯一的集中清单 —— 新增变量必须同时登记在这里。

# ── 路径解析 ────────────────────────────────────────────────
AIMERGENT_FRAMEWORK_ROOT=      # 框架根。dispatch/new_agent 解析角色卡用；
                               # 不设则回退读模块内的 .aimergent-framework（相对路径）
AIMERGENT_PROJECT_ROOT=        # 脚本自身所在仓的顶层，一般自动推导
AIMERGENT_WORKSPACE_ROOT=      # 模块落地的工作区根，默认 = PROJECT_ROOT
AIMERGENT_TEMPLATE_ROOT=       # 模块骨架来源，默认 <框架根>/code/_template
AIMERGENT_CI_SOURCE=           # 门禁文件来源目录，默认 <框架根>/scripts

# ── 角色边界（new_agent.sh 填角色卡用；不设则用角色默认值）──
AIMERGENT_WRITABLE=
AIMERGENT_READONLY=
AIMERGENT_FORBIDDEN=

# ── 门禁行为 ────────────────────────────────────────────────
AIMERGENT_REPORT_BASE=         # 报告门禁的任务起点 sha。区间为空时门禁会要求显式指定
AIMERGENT_REPORT_HEAD=         # 默认 HEAD
AIMERGENT_ATTRIBUTION_BASE=    # 归属检查的起点，CI 里由 PR 事件推导
AIMERGENT_FORBIDDEN_PATH_PREFIX=  # 项目自定义的禁止路径前缀，不设则跳过该 gate
AIMERGENT_PROJECT_SLUG=        # 项目 slug，用于归属 trailer 校验

# ── 逃生口（放行但强制记账，绝不静默）──────────────────────
AIMERGENT_MISSION_OVERRIDE=    # 完工检测不过时强行放行，理由会写进 logs/diary.jsonl

# ── 一次性握手令牌（由脚本自己铸，人不要手设）──────────────
AIMERGENT_PUSH_LEASE=          # arbiter-push.sh 铸；单独设置无效
AIMERGENT_PUSH_LEASE_NONCE=
AIMERGENT_PUSH_LEASE_TOKEN_FILE=
AIMERGENT_MERGE_GATE=          # merge-to-main.sh 铸；单独设置无效
AIMERGENT_MERGE_GATE_NONCE=
AIMERGENT_MERGE_GATE_TOKEN_FILE=
AIMERGENT_PUSH_GUARD_LOG=      # 推送拦截日志落点
